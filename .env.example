# Development mode - remove this line for production
ENVIRONMENT=dev

# API Keys for LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...

# Database configuration
# For development (SQLite, when ENVIRONMENT=dev):
#   - These values are not used
#   - SQLite file is created at routellm/kavya.db
#
# For production (PostgreSQL, when ENVIRONMENT is not set):
#   - Required: INSTANCE_CONNECTION_NAME, DB_PASS
#   - Optional: DB_USER, DB_NAME (both default to "kavya")
INSTANCE_CONNECTION_NAME=project-id:region:instance-name
DB_PASS=your-database-password
DB_USER=kavya
DB_NAME=kavya

# JWT Configuration
JWT_TEST_TOKEN=your.jwt.token
JWT_PUBLIC_KEY_B64=base64encoded-public-key

# Optional Database Configuration
# DB_SOCKET_DIR=/cloudsql  # Default socket directory for Cloud SQL
# PRIVATE_IP=true          # Use private IP for Cloud SQL connection 