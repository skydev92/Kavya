# Environment (dev/prod)
ENVIRONMENT=dev

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
BRAVE_SEARCH_API_KEY=
JINA_API_KEY=

# JWT Public Key Base64 encoded
JWT_PUBLIC_KEY_B64=
# DXPR JWT API Test Token for database warmup test
JWT_TEST_TOKEN=

# Database Configuration
# For development (local PostgreSQL):
DATABASE_URL=postgresql://kavya_user:postgres@localhost:5432/kavya_db

# For production (Google Cloud SQL), uncomment and fill these:
# INSTANCE_CONNECTION_NAME=project:region:instance
# DATABASE_URL=postgresql://kavya_user:your-prod-password@localhost:5432/kavya_db
# PRIVATE_IP=true  # Optional, set to true if using private IP